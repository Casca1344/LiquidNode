# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
build/
out/

# Environment and secrets (never commit real credentials)
.env
.env.*
!.env.example

# Logs and diagnostics
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log.*

# OS junk
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# Editors and local tooling
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Vite / tooling caches
.vite/
.cache/
.parcel-cache/
.turbo/
*.tsbuildinfo

# Test coverage
coverage/
.nyc_output/

# Deploy / hosting metadata (often machine-specific)
.vercel/
.netlify/

# Optional local overrides
*.local

# Certificates / keys (if ever generated locally)
*.pem
*.p12
*.key
